# build outputs / generated artifacts
# build/ is the CMake binary directory (cmake -S . -B build)
build/

# CMake leftovers from an accidental in-source configure (cmake .)
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Testing/
install_manifest.txt

# corpus re-download backups (created by tools/fetch_corpus.sh --force)
raw.bak.*/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# editors
.vscode/
.idea/

# clangd index cache (appears once build/compile_commands.json exists)
.cache/

# LaTeX auxiliary files. report.tex is compiled with
# latexmk -xelatex -outdir=build, but an accidental in-source xelatex run
# should not add these to the repository.
*.aux
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.xdv
*.synctex.gz
